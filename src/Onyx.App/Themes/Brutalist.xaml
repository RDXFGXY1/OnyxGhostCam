<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Onyx brutalist HUD palette: dark red + black ===== -->
    <Color x:Key="BgBlackColor">#FF0A0A0A</Color>
    <Color x:Key="PanelColor">#FF141414</Color>
    <Color x:Key="AccentRedColor">#FFB01818</Color>
    <Color x:Key="AccentRedDimColor">#FF5A0C0C</Color>
    <Color x:Key="TextColor">#FFE0E0E0</Color>

    <SolidColorBrush x:Key="BgBlack" Color="{StaticResource BgBlackColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="AccentRed" Color="{StaticResource AccentRedColor}" />
    <SolidColorBrush x:Key="AccentRedDim" Color="{StaticResource AccentRedDimColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />

    <!-- Fonts (Bebas Neue headers / Space Mono body) are bundled under Assets/Fonts later. -->
    <!-- Placeholder families until the .ttf files are added: -->
    <FontFamily x:Key="HeaderFont">Consolas</FontFamily>
    <FontFamily x:Key="BodyFont">Consolas</FontFamily>

</ResourceDictionary>
