<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Onyx brutalist HUD palette: dark red + black ===== -->
    <Color x:Key="BgBlackColor">#FF08090B</Color>
    <Color x:Key="PanelColor">#FF101216</Color>
    <Color x:Key="Surface2Color">#FF16181D</Color>
    <Color x:Key="Surface3Color">#FF1D2026</Color>
    <Color x:Key="LineColor">#FF22252B</Color>
    <Color x:Key="LineStrongColor">#FF2E323A</Color>
    <Color x:Key="AccentRedColor">#FFE10600</Color>
    <Color x:Key="AccentRedDimColor">#FF3A0F10</Color>
    <Color x:Key="TextColor">#FFE9EBEE</Color>
    <Color x:Key="TextDimColor">#FF9AA0A8</Color>
    <Color x:Key="TextMutedColor">#FF636A73</Color>
    <Color x:Key="OkColor">#FF35C77E</Color>

    <SolidColorBrush x:Key="BgBlack" Color="{StaticResource BgBlackColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="LineStrong" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="AccentRed" Color="{StaticResource AccentRedColor}" />
    <SolidColorBrush x:Key="AccentRedDim" Color="{StaticResource AccentRedDimColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />

    <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF14171B" Offset="0" />
        <GradientStop Color="#FF101216" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF01A12" Offset="0" />
        <GradientStop Color="#FFC00500" Offset="1" />
    </LinearGradientBrush>

    <!-- Fonts: comma-separated fallbacks. Drop Bebas Neue / Space Mono .ttf into
         Assets/Fonts and change these two lines to use them (see Assets/Fonts/README). -->
    <FontFamily x:Key="HeaderFont">Bahnschrift SemiBold Condensed, Arial Narrow, Consolas</FontFamily>
    <FontFamily x:Key="BodyFont">Consolas, Cascadia Mono, Courier New</FontFamily>

    <!-- Scanline overlay: 2px dark line / 2px gap, low opacity, tiled. -->
    <DrawingBrush x:Key="Scanlines" TileMode="Tile"
                  Viewport="0,0,3,3" ViewportUnits="Absolute" Opacity="0.16">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#FF000000">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,3,1.5" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===== Label text styles ===== -->
    <!-- ====== premium component set ====== -->

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <SolidColorBrush x:Key="AccentSoft" Color="#FF8E1512" />
    <FontFamily x:Key="UiDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>

    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="RowSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- numbered step chip -->
    <Style x:Key="StepBadge" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="#1AE10600" />
        <Setter Property="BorderBrush" Value="#4DE10600" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StepNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentRed}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- grouped inner panel -->
    <Style x:Key="SubCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,13" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="IconChip" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="#14E10600" />
        <Setter Property="BorderBrush" Value="#33E10600" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- cover-mode card -->
    <Style x:Key="ModeCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="8" Padding="10,12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1FE10600" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentRed}" />
                            <Setter Property="Foreground" Value="#FFFF6B62" />
                            <Setter TargetName="b" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource AccentRedColor}" BlurRadius="12"
                                                      ShadowDepth="0" Opacity="0.30" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- primary action -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{StaticResource AccentFill}" BorderBrush="#FFFF2A20"
                            BorderThickness="1" CornerRadius="7">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource AccentRedColor}" BlurRadius="18"
                                              ShadowDepth="0" Opacity="0.30" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFFF1A11" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFA80400" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="#FF221619" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF2A1B1D" />
                            <Setter TargetName="b" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- secondary / destructive -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#FFD98D8A" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{StaticResource Surface2}" BorderBrush="#FF43262A"
                            BorderThickness="1" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1FE10600" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF8E1512" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF0E1013" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="#FF0E1013" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF1C1F24" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- accent outline (TEST CLOAK) -->
    <Style x:Key="AccentOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#FFFF6B62" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="#14E10600" BorderBrush="#59E10600"
                            BorderThickness="1" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#2BE10600" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentRed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="Transparent" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF1C1F24" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- stepper glyph button -->
    <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#26E10600" />
                            <Setter Property="Foreground" Value="{StaticResource AccentRed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF33383F" />
                            <Setter TargetName="b" Property="Background" Value="#FF0E1013" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ValueBox" TargetType="Border">
        <Setter Property="Width" Value="54" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="#FF0C0E11" />
        <Setter Property="BorderBrush" Value="#40E10600" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="5,0" />
    </Style>

    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentRed}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- calibration slider -->
    <Style x:Key="CalSlider" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="#FF23262C" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource AccentRed}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="15" Height="15" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="{StaticResource AccentRed}">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="{StaticResource AccentRedColor}"
                                                                          BlurRadius="10" ShadowDepth="0" Opacity="0.55" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <Ellipse Width="5" Height="5" Fill="White" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HudLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="HudValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Foreground" Value="{StaticResource AccentRed}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Button ===== -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource AccentRed}" />
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentRed}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentRed}" />
                            <Setter Property="Foreground" Value="{StaticResource BgBlack}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentRedDim}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ToggleButton (used for the SHIELD switch) ===== -->
    <Style TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentRedDim}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="12,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentRed}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentRed}" />
                            <Setter Property="Foreground" Value="{StaticResource BgBlack}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentRed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar ===== -->
    <Style x:Key="ScrollArrow" TargetType="RepeatButton">
        <Setter Property="Height" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="b" Background="{StaticResource BgBlack}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentRedDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="{StaticResource BgBlack}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{StaticResource BgBlack}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <RepeatButton Grid.Row="0" Style="{StaticResource ScrollArrow}"
                                      Command="ScrollBar.LineUpCommand">
                            <Path Data="M0,5 L5,0 L10,5" Stroke="{StaticResource AccentRed}" StrokeThickness="1.6" />
                        </RepeatButton>

                        <Track Grid.Row="1" x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="t" Background="{StaticResource AccentRedDim}"
                                                    BorderBrush="{StaticResource AccentRed}" BorderThickness="1"
                                                    Margin="2,0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="t" Property="Background" Value="{StaticResource AccentRed}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>

                        <RepeatButton Grid.Row="2" Style="{StaticResource ScrollArrow}"
                                      Command="ScrollBar.LineDownCommand">
                            <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource AccentRed}" StrokeThickness="1.6" />
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Title-bar caption button ===== -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentRed}" />
                            <Setter Property="Foreground" Value="{StaticResource BgBlack}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TextBox ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgBlack}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentRed}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentRedDim}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentRed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Section header ===== -->
    <Style x:Key="HudSection" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource AccentRed}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <!-- ===== Illuminated selector button (RadioButton) ===== -->
    <Style x:Key="SelectorButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="{StaticResource BgBlack}"
                            BorderBrush="{StaticResource AccentRedDim}" BorderThickness="2" Padding="4,7">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentRed}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentRed}" />
                            <Setter Property="Foreground" Value="{StaticResource BgBlack}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentRed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cockpit rocker switch (ToggleButton) ===== -->
    <Style x:Key="CockpitSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Width="60" Height="30" CornerRadius="15"
                            Background="{StaticResource BgBlack}"
                            BorderBrush="{StaticResource AccentRedDim}" BorderThickness="2">
                        <Ellipse x:Name="knob" Width="20" Height="20"
                                 Fill="{StaticResource AccentRedDim}"
                                 HorizontalAlignment="Left" Margin="4,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource AccentRed}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentRed}" />
                            <Setter TargetName="track" Property="Background" Value="#33C81E1E" />
                            <Setter TargetName="knob" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource AccentRedColor}"
                                                      BlurRadius="14" ShadowDepth="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentRed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox: square red box, fills when checked ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="16" Height="16" VerticalAlignment="Center"
                                Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource AccentRed}" BorderThickness="2">
                            <Rectangle x:Name="fill" Margin="2" Fill="{StaticResource AccentRed}"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider: thin red track + square thumb ===== -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentRed}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="3" Background="{StaticResource AccentRedDim}" />
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Width="10" Height="18" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="{StaticResource AccentRed}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
