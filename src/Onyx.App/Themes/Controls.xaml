<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Onyx.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Bracket-corner HUD frame -->
    <Style TargetType="{x:Type c:BracketFrame}">
        <Setter Property="Background" Value="#FF000000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:BracketFrame}">
                    <Grid>
                        <!-- content -->
                        <Border Background="{TemplateBinding Background}" Margin="6">
                            <ContentPresenter />
                        </Border>

                        <!-- scanline overlay -->
                        <Rectangle Margin="6" IsHitTestVisible="False"
                                   Fill="{StaticResource Scanlines}"
                                   Visibility="{Binding ShowScanlines,
                                       RelativeSource={RelativeSource TemplatedParent},
                                       Converter={StaticResource BoolToVis}}" />

                        <!-- corner brackets -->
                        <Path Data="M0,18 L0,0 L18,0" Stroke="{StaticResource AccentRed}" StrokeThickness="2"
                              Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Path Data="M0,0 L18,0 L18,18" Stroke="{StaticResource AccentRed}" StrokeThickness="2"
                              Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Path Data="M0,0 L0,18 L18,18" Stroke="{StaticResource AccentRed}" StrokeThickness="2"
                              Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Path Data="M18,0 L18,18 L0,18" Stroke="{StaticResource AccentRed}" StrokeThickness="2"
                              Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

                        <!-- label -->
                        <Border Background="{StaticResource AccentRed}" Padding="6,1"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,0,0,0">
                            <TextBlock Text="{TemplateBinding Label}"
                                       FontFamily="{StaticResource HeaderFont}" FontSize="13"
                                       Foreground="{StaticResource BgBlack}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
