<Window x:Class="Onyx.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Onyx.App.Controls"
        Title="GHOSTCAM"
        Height="860" Width="520"
        Background="{StaticResource BgBlack}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="False">

    <Window.Resources>
        <Style x:Key="StepLed" TargetType="TextBlock">
            <Setter Property="Text" Value="●" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="PanelHeader" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

  <Border BorderBrush="{StaticResource AccentRed}" BorderThickness="2">
   <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Custom title bar (drag to move) ===== -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" Height="30"
            MouseLeftButtonDown="OnTitleBarDrag">
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Rectangle Width="10" Height="10" Fill="{StaticResource AccentRed}" VerticalAlignment="Center" />
                <TextBlock Text="GHOSTCAM" FontFamily="{StaticResource BodyFont}" FontSize="12"
                           Foreground="{StaticResource Text}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="▾" Style="{StaticResource CaptionButton}" Click="OnHideToTray"
                        ToolTip="Hide to tray" />
                <Button Content="—" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize" />
                <Button Content="✕" Style="{StaticResource CaptionButton}" Click="OnCloseWindow" ToolTip="Close" />
            </StackPanel>
        </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="GHOSTCAM" FontFamily="{StaticResource HeaderFont}" FontSize="34"
                       Foreground="{StaticResource AccentRed}" />
            <StackPanel VerticalAlignment="Center" Margin="12,3,0,0">
                <TextBlock Text="// NULL STUDIO" Style="{StaticResource HudValue}" FontSize="13" />
                <TextBlock Text="PROCEDURAL FLIGHT CONTROL" Style="{StaticResource HudLabel}" />
            </StackPanel>
        </StackPanel>

        <!-- ===== Docked preview ===== -->
        <c:BracketFrame Grid.Row="1" Label="FEED MONITOR" Height="196">
            <Grid>
                <Image x:Name="DockPreview" Stretch="Uniform" />
                <TextBlock x:Name="PreviewHint" Text="FEED OFFLINE" Style="{StaticResource HudLabel}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </c:BracketFrame>

        <!-- ===== Master bar ===== -->
        <Border Grid.Row="2" Margin="0,10,0,0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource AccentRedDim}" BorderThickness="2" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="MasterLed" Width="14" Height="14" Fill="{StaticResource TextDim}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="MasterStatus" Text="SYSTEM SAFE" FontFamily="{StaticResource HeaderFont}"
                               FontSize="17" Foreground="{StaticResource Text}" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="KillButton" Content="MASTER KILL" Width="130" Height="30"
                        HorizontalAlignment="Right" Click="OnMasterKill" />
            </Grid>
        </Border>

        <!-- ===== Procedure panels ===== -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel Margin="0,0,8,0">

                <!-- ========== SENSOR ========== -->
                <Button Style="{StaticResource PanelHeader}" Click="OnToggleSensor">
                    <Grid>
                        <TextBlock Text="◤ SENSOR" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="SensorState" Text="SAFE" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="13" />
                    </Grid>
                </Button>
                <Border x:Name="SensorContent" BorderBrush="{StaticResource AccentRedDim}" BorderThickness="2,0,2,2"
                        Padding="14,12" Visibility="Visible">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SLed1" Style="{StaticResource StepLed}" />
                                <TextBlock Text="1 · POWER" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ToggleButton x:Name="SensorPowerSw" Style="{StaticResource CockpitSwitch}"
                                          HorizontalAlignment="Right" Checked="OnSensorPower" Unchecked="OnSensorPower" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SLed2" Style="{StaticResource StepLed}" />
                                <TextBlock Text="2 · SELECT INPUT" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CamDown" Content="−" Width="30" Height="28" Tag="cam-" Click="OnStep" />
                                <TextBlock x:Name="CamVal" Text="0" Style="{StaticResource HudValue}"
                                           Width="36" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button x:Name="CamUp" Content="+" Width="30" Height="28" Tag="cam+" Click="OnStep" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SLed3" Style="{StaticResource StepLed}" />
                                <TextBlock Text="3 · ACQUIRE FEED" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="AcquireBtn" Content="ACQUIRE" Width="110" Height="30"
                                    HorizontalAlignment="Right" Click="OnAcquire" />
                        </Grid>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SLed4" Style="{StaticResource StepLed}" />
                                <TextBlock Text="4 · VERIFY" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SensorAbort" Content="ABORT" Width="80" Height="30" Click="OnSensorAbort" />
                                <Button x:Name="ConfirmFeed" Content="CONFIRM" Width="100" Height="30"
                                        Margin="8,0,0,0" Click="OnConfirmFeed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== CLOAK ========== -->
                <Button Style="{StaticResource PanelHeader}" Click="OnToggleCloak">
                    <Grid>
                        <TextBlock Text="◤ CLOAK" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="CloakState" Text="LOCKED" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="13" />
                    </Grid>
                </Button>
                <Border x:Name="CloakContent" BorderBrush="{StaticResource AccentRedDim}" BorderThickness="2,0,2,2"
                        Padding="14,12" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CLed1" Style="{StaticResource StepLed}" />
                                <TextBlock Text="1 · ENABLE MODULE" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ToggleButton x:Name="CloakEnableSw" Style="{StaticResource CockpitSwitch}"
                                          HorizontalAlignment="Right" Checked="OnCloakEnable" Unchecked="OnCloakEnable" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="CLed2" Style="{StaticResource StepLed}" />
                            <TextBlock Text="2 · COVER MODE" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <RadioButton x:Name="CoverMosaic" GroupName="COVER" Content="MOSAIC" Tag="0"
                                         Style="{StaticResource SelectorButton}" Checked="OnCoverSel" />
                            <RadioButton x:Name="CoverBlack" GroupName="COVER" Content="BLACK" Tag="1"
                                         Style="{StaticResource SelectorButton}" Checked="OnCoverSel" />
                            <RadioButton x:Name="CoverGhost" GroupName="COVER" Content="GHOST" Tag="2"
                                         Style="{StaticResource SelectorButton}" Checked="OnCoverSel" />
                            <RadioButton x:Name="CoverCensor" GroupName="COVER" Content="CENSOR" Tag="3"
                                         Style="{StaticResource SelectorButton}" Checked="OnCoverSel" />
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="CLed3" Style="{StaticResource StepLed}" />
                            <TextBlock Text="3 · CALIBRATE" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="24,0,0,6">
                            <TextBlock Text="STRENGTH" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="−" Width="30" Height="28" Tag="strength-" Click="OnStep" />
                                <TextBlock x:Name="StrengthVal" Text="16" Style="{StaticResource HudValue}"
                                           Width="36" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Content="+" Width="30" Height="28" Tag="strength+" Click="OnStep" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="24,0,0,6">
                            <TextBlock Text="SENSITIVITY" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="−" Width="30" Height="28" Tag="sens-" Click="OnStep" />
                                <TextBlock x:Name="SensVal" Text="60" Style="{StaticResource HudValue}"
                                           Width="36" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Content="+" Width="30" Height="28" Tag="sens+" Click="OnStep" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="24,0,0,10">
                            <TextBlock Text="SCAN RATE" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="−" Width="30" Height="28" Tag="rate-" Click="OnStep" />
                                <TextBlock x:Name="RateVal" Text="3" Style="{StaticResource HudValue}"
                                           Width="36" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Content="+" Width="30" Height="28" Tag="rate+" Click="OnStep" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CLed4" Style="{StaticResource StepLed}" />
                                <TextBlock Text="4 · TEST CLOAK" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="TestBtn" Content="TEST" Width="110" Height="30"
                                    HorizontalAlignment="Right" Click="OnTestCloak" />
                        </Grid>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CLed5" Style="{StaticResource StepLed}" />
                                <TextBlock Text="5 · CONFIRM" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CloakAbort" Content="ABORT" Width="80" Height="30" Click="OnCloakAbort" />
                                <Button x:Name="ConfirmCloak" Content="ENGAGE" Width="100" Height="30"
                                        Margin="8,0,0,0" Click="OnConfirmCloak" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== UPLINK ========== -->
                <Button Style="{StaticResource PanelHeader}" Click="OnToggleUplink">
                    <Grid>
                        <TextBlock Text="◤ UPLINK" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="UplinkState" Text="LOCKED" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="13" />
                    </Grid>
                </Button>
                <Border x:Name="UplinkContent" BorderBrush="{StaticResource AccentRedDim}" BorderThickness="2,0,2,2"
                        Padding="14,12" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="ULed1" Style="{StaticResource StepLed}" />
                            <TextBlock Text="1 · PRE-FLIGHT CHECK" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Margin="24,0,0,10">
                            <TextBlock x:Name="ChkSensor" Text="○ SENSOR" Style="{StaticResource HudLabel}" />
                            <TextBlock x:Name="ChkCloak" Text="○ CLOAK" Style="{StaticResource HudLabel}" Margin="0,3,0,0" />
                            <TextBlock x:Name="ChkObs" Text="○ OBS DRIVER" Style="{StaticResource HudLabel}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="ULed2" Style="{StaticResource StepLed}" />
                            <TextBlock Text="2 · PAYLOAD" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <UniformGrid Columns="3" Margin="24,0,0,8">
                            <RadioButton x:Name="FilterNone" GroupName="FILT" Content="NONE" Tag="0"
                                         Style="{StaticResource SelectorButton}" Checked="OnFilterSel" />
                            <RadioButton x:Name="FilterScan" GroupName="FILT" Content="SCAN" Tag="1"
                                         Style="{StaticResource SelectorButton}" Checked="OnFilterSel" />
                            <RadioButton x:Name="FilterGlitch" GroupName="FILT" Content="GLITCH" Tag="2"
                                         Style="{StaticResource SelectorButton}" Checked="OnFilterSel" />
                        </UniformGrid>
                        <Grid Margin="24,0,0,10">
                            <TextBlock Text="TACTICAL HUD" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="HudSwitch" Style="{StaticResource CockpitSwitch}"
                                          HorizontalAlignment="Right" Checked="OnHudSw" Unchecked="OnHudSw" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="ULed3" Style="{StaticResource StepLed}" />
                            <TextBlock Text="3 · ARM GUARD" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="ArmGuardBtn" Content="⚠  LIFT ARM GUARD  ⚠" Height="38"
                                Margin="24,0,0,10" Click="OnLiftGuard" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="ULed4" Style="{StaticResource StepLed}" />
                            <TextBlock Text="4 · BROADCAST" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="BroadcastBtn" Height="46" Margin="24,0,0,10"
                                Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentRed}"
                                BorderThickness="2" IsEnabled="False"
                                PreviewMouseLeftButtonDown="OnBroadcastDown"
                                PreviewMouseLeftButtonUp="OnBroadcastUp" MouseLeave="OnBroadcastUp">
                            <Grid>
                                <Rectangle x:Name="BroadcastFill" Fill="{StaticResource AccentRedDim}"
                                           HorizontalAlignment="Left" Width="0" />
                                <TextBlock Text="HOLD TO BROADCAST" FontFamily="{StaticResource HeaderFont}"
                                           FontSize="15" Foreground="{StaticResource Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Button x:Name="UplinkAbort" Content="STOP UPLINK" Height="30" Click="OnUplinkAbort" />
                    </StackPanel>
                </Border>

                <!-- ========== CONFIG ========== -->
                <Button Style="{StaticResource PanelHeader}" Click="OnToggleConfig">
                    <TextBlock Text="◤ CONFIG" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Button>
                <Border x:Name="ConfigContent" BorderBrush="{StaticResource AccentRedDim}" BorderThickness="2,0,2,2"
                        Padding="14,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="RESOLUTION" Style="{StaticResource HudLabel}" Margin="0,0,0,4" />
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <RadioButton x:Name="Res720" GroupName="RES" Content="720p" Tag="720"
                                         Style="{StaticResource SelectorButton}" Checked="OnResSel" />
                            <RadioButton x:Name="Res1080" GroupName="RES" Content="1080p" Tag="1080"
                                         Style="{StaticResource SelectorButton}" Checked="OnResSel" />
                        </UniformGrid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="PARANOID (cover if no face)" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="ParanoidSwitch" Style="{StaticResource CockpitSwitch}"
                                          HorizontalAlignment="Right" Checked="OnParanoidSw" Unchecked="OnParanoidSw" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="GPU ACCELERATION" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="GpuSwitch" Style="{StaticResource CockpitSwitch}"
                                          HorizontalAlignment="Right" Checked="OnGpuSw" Unchecked="OnGpuSw" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="MIRROR ALL (video + text)" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="MirrorSwitch" Style="{StaticResource CockpitSwitch}"
                                          HorizontalAlignment="Right" Checked="OnMirrorSw" Unchecked="OnMirrorSw" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="MIRROR TEXT ONLY (keep video)" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="MirrorTextSwitch" Style="{StaticResource CockpitSwitch}"
                                          HorizontalAlignment="Right" Checked="OnMirrorTextSw" Unchecked="OnMirrorTextSw" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="AUTO-ARM ON BOOT" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="BootSwitch" Style="{StaticResource CockpitSwitch}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="COCKPIT AUDIO" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="SoundSwitch" Style="{StaticResource CockpitSwitch}"
                                          HorizontalAlignment="Right" Checked="OnSoundSw" Unchecked="OnSoundSw" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ========== OVERLAYS ========== -->
                <Button Style="{StaticResource PanelHeader}" Click="OnToggleOverlays">
                    <TextBlock Text="◤ OVERLAYS" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Button>
                <Border x:Name="OverlaysContent" BorderBrush="{StaticResource AccentRedDim}" BorderThickness="2,0,2,2"
                        Padding="14,12" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="WATERMARK" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="WatermarkSwitch" Style="{StaticResource CockpitSwitch}"
                                          HorizontalAlignment="Right" Checked="OnWatermarkSw" Unchecked="OnWatermarkSw" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GHOSTCAM ·" Style="{StaticResource HudValue}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" x:Name="WatermarkNameBox" Text="KYROS"
                                     TextChanged="OnWatermarkName" />
                        </Grid>

                        <Border Height="2" Background="{StaticResource AccentRedDim}" Margin="0,0,0,10" />

                        <Button Content="OPEN OVERLAY EDITOR" Height="40" Click="OnOpenEditor" />
                        <TextBlock Text="drag text / images anywhere on the stage" Style="{StaticResource HudLabel}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ========== DIAG ========== -->
                <Button Style="{StaticResource PanelHeader}" Click="OnToggleDiag">
                    <TextBlock Text="◤ DIAGNOSTICS" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Button>
                <Border x:Name="DiagContent" BorderBrush="{StaticResource AccentRedDim}" BorderThickness="2,0,2,2"
                        Padding="14,12" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="THROUGHPUT" Style="{StaticResource HudLabel}" />
                            <TextBlock x:Name="FpsText" Text="-- FPS" HorizontalAlignment="Right"
                                       Style="{StaticResource HudValue}" FontSize="15" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="ACCELERATION" Style="{StaticResource HudLabel}" />
                            <TextBlock x:Name="AccelText" Text="--" HorizontalAlignment="Right"
                                       Style="{StaticResource HudValue}" />
                        </Grid>
                        <Button x:Name="PopOutButton" Content="POP-OUT MONITOR" Height="34" Margin="0,6,0,0"
                                Click="OnPopOutClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="4" Margin="0,10,0,0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource AccentRedDim}" BorderThickness="0,2,0,0" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="STATUS:" Style="{StaticResource HudLabel}" />
                <TextBlock x:Name="StatusText" Text="idle" Style="{StaticResource HudValue}"
                           Foreground="{StaticResource Text}" Margin="8,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
   </Grid>
  </Border>
</Window>
