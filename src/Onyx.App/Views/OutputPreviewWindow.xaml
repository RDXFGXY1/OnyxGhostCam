<Window x:Class="Onyx.App.Views.OutputPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GHOSTCAM // OUTPUT MONITOR"
        Height="260" Width="400"
        Background="{StaticResource BgBlack}"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True">
    <Border BorderBrush="{StaticResource AccentRed}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Panel}" Height="26"
                    MouseLeftButtonDown="OnDrag">
                <Grid>
                    <TextBlock Text="LIVE OUTPUT" FontFamily="{StaticResource BodyFont}" FontSize="11"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Button Content="✕" Style="{StaticResource CaptionButton}" Height="24"
                            HorizontalAlignment="Right" Click="OnCloseClick" />
                </Grid>
            </Border>
            <Image Grid.Row="1" x:Name="PopImage" Stretch="Uniform" />
        </Grid>
    </Border>
</Window>
