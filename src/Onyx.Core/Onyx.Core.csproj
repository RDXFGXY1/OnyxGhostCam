<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Onyx.Core</RootNamespace>
    <AssemblyName>Onyx.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ONNX Runtime with DirectML GPU acceleration (RTX 4050) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.17.1" />
    <!-- Webcam capture + image ops (mosaic, resize, drawing) -->
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.10.0.20241108" />
  </ItemGroup>

</Project>
